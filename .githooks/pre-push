#!/usr/bin/env bash
# Pre-push Veridian CRM — garde-fous fork Twenty.
#
# Installé via : git config core.hooksPath .githooks
# (pas de husky ici : le repo tourne sans node_modules en local — la
# batterie de tests complète vit en CI GitHub, cf veridian-crm-ci.yaml)
#
# Garde-fous :
#  1. LÉGAL — refuse tout push qui modifie un fichier `@license Enterprise`
#     (contrefaçon, cf docs/spec/AUDIT-LIMITE-EE-TWENTY.md)
#  2. TRUNK — refuse le push d'une branche autre que staging/main
#  3. SECRETS — refuse les patterns de credentials évidents dans le diff

set -euo pipefail

remote="$1"
z40=0000000000000000000000000000000000000000
repo_root="$(git rev-parse --show-toplevel)"

fail() { echo "❌ pre-push: $1" >&2; exit 1; }

# Étage 0 — garde-fou légal partagé avec la CI (single source of truth) :
# aucun fichier @license Enterprise modifié depuis le fork. Échoue ici, avant
# la CI. Le script tolère un marker absent (clone shallow) en exit 2 → on ne
# bloque pas le push local là-dessus, seule une vraie violation (exit 1) bloque.
if [ -x "$repo_root/scripts/ci/check-ee-integrity.sh" ]; then
  # Veridian (26/11/2026) : « if ! cmd; then rc=$? » lisait le code de la négation (0) : la garde ne bloquait jamais.
  rc=0
  bash "$repo_root/scripts/ci/check-ee-integrity.sh" || rc=$?
  [ "$rc" -eq 1 ] && fail "check-ee-integrity : un fichier Enterprise a été modifié (contrefaçon) ou dépendance toxique"
fi

# Étage 0 ter (26/11/2026) : un fichier que la marque remplace au build (index.html, icônes) a changé : la CI le refusait
# 25 min plus tard (garde-legale). Contrôle par empreintes, une seconde.
rc=0
bash "$repo_root/scripts/ci/poser-marque.sh" --verifier >/dev/null || rc=$?
[ "$rc" -eq 1 ] && fail "poser-marque : un fichier remplacé par la marque a changé, l'éditer dans deploy/marque (ou rejouer scripts/ci/marque.sh)"

# Étage 0 bis : un patch Veridian disparu (limite, canaux sortants, rebond Hub) bloque le push.
if [ -x "$repo_root/scripts/ci/patch-survival.sh" ]; then
  bash "$repo_root/scripts/ci/patch-survival.sh" --statique || fail "patch-survival : un patch Veridian a disparu"
fi

# Étage 0 ter : dépôt public, aucune adresse de personne (0 conforme, 1 trouvée, 2 non abouti : rouge aussi).
bash "$repo_root/scripts/ci/adresses-personnes.sh" || fail "adresses-personnes : adresse de personne dans le dépôt ou contrôle non abouti"

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z40" ] && continue  # suppression de branche

  branch="${remote_ref#refs/heads/}"
  case "$branch" in
    staging|main) ;;
    *) fail "branche distante '$branch' interdite — trunk-based sur staging/main uniquement (cf CLAUDE.md)" ;;
  esac

  if [ "$remote_sha" = "$z40" ]; then
    range="$local_sha --not --remotes=$remote"
  else
    range="$remote_sha..$local_sha"
  fi

  changed=$(git diff --name-only --diff-filter=ACMR $range -- '*.ts' '*.tsx' 2>/dev/null || true)

  # 1. Fichiers EE intouchables.
  # Source de vérité légale = marker de fork (défaut de check-ee-integrity.sh) :
  # on ne flague QUE les fichiers EE dont le CONTENU diffère de leur version au
  # marker (= vraie modif Veridian). Un merge de sync upstream embarque forcément
  # des commits upstream qui touchent des fichiers EE — ce n'est PAS notre fait :
  # le range origin/staging..HEAD les contient, mais leur contenu est identique au
  # marker (la nouvelle base) → on les ignore. check-ee-integrity (étage 0) reste
  # le filet exhaustif. Sans ce raffinement, tout merge de sync était bloqué à tort.
  fork_marker="$(sed -n 's/^FORK_MARKER="\${1:-\([^}]*\)}".*/\1/p' \
    "$repo_root/scripts/ci/check-ee-integrity.sh" 2>/dev/null)"
  for f in $changed; do
    if git show "$local_sha:$f" 2>/dev/null | head -3 | grep -q "@license Enterprise"; then
      # Fichier EE présent au marker ET contenu identique au marker → modif upstream
      # pure embarquée par le merge, pas une contrefaçon Veridian. On laisse passer.
      if [ -n "$fork_marker" ] \
         && git cat-file -e "$fork_marker:$f" 2>/dev/null \
         && git diff --quiet "$fork_marker" "$local_sha" -- "$f" 2>/dev/null; then
        continue
      fi
      fail "le fichier '$f' porte le header '@license Enterprise' — modification INTERDITE (contrefaçon). Cherche un autre angle (ENV gate, guard côté AGPL)."
    fi
  done

  # 1 bis. Un auteur « .local » est une identité d'épreuve laissée dans .git/config.
  if git log --format='%ae%n%ce' "$local_sha" --not --remotes="$remote" | grep -q '\.local$\|@local$'; then
    fail "auteur d'épreuve dans les commits poussés : git config --local --remove-section user, puis git commit --amend --reset-author"
  fi

  # 2. Secrets évidents dans le diff
  if git diff $range -- . ':(exclude)*.lock' 2>/dev/null \
    | grep -E "^\+" \
    | grep -qE "(sk_live_[A-Za-z0-9]{20,}|whsec_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|-----BEGIN (RSA |EC )?PRIVATE KEY)"; then
    fail "credential détecté dans le diff (sk_live/whsec/AKIA/clé privée) — retire-le et passe par l'ENV Dokploy / .all-creds.env"
  fi
done

# 3. Un sabotage qui ne s'applique plus rougit la CI bien après le push (25/11/2026). Étape lourde (465 node, 88 s de CPU) :
# sur le bastion, lourd la joue ailleurs (rise, node02, nice 19) sur le code commité extrait ici ; « NON ABOUTI » (lourd n'a
# rien fait tourner) ne laisse pas passer : la même étape est rejouée sur place en nice 19 (règle commune, parente 26/11).
arbre=$(mktemp -d "$repo_root/.motifs-arbre.XXXXXX")
trap 'rm -rf "$arbre"' EXIT
git -C "$repo_root" archive HEAD scripts/ci packages/twenty-server/src/engine packages/twenty-server/src/modules \
  packages/twenty-front/src packages/twenty-shared/src | tar -x -C "$arbre" || fail "motifs : extraction du code commité impossible"
rel="${arbre#"$repo_root"/}"
journal=$(mktemp)
rc=0
(cd "$repo_root" && lourd-si-bastion bash "$rel/scripts/ci/motifs-sabotages.sh" --arbre "$rel") >"$journal" 2>&1 || rc=$?
# Code 2 ou 255 = rien n'a abouti ailleurs (27/11 : installation yarn en échec sur le nœud).
if [ "$rc" = 2 ] || [ "$rc" = 255 ]; then
  echo "pre-push : lourd non abouti, motifs rejoués sur place (nice 19)"
  rc=0
  nice -n 19 bash "$arbre/scripts/ci/motifs-sabotages.sh" --arbre "$arbre" >"$journal" 2>&1 || rc=$?
fi
grep -E "MOTIF|NON ABOUTI" "$journal" | tail -5 || true
rm -f "$journal"
[ "$rc" = 0 ] || fail "motif de sabotage périmé ou vérification non aboutie (scripts/ci/motifs-sabotages.sh)"

echo "✅ pre-push: garde-fous EE/trunk/secrets OK"
