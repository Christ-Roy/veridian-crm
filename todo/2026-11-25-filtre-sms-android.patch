@@ -0,0 +1,18 @@
+package site.veridian.telephonie.contrat
+
+/**
+ * Vie privée : un SMS ou MMS part vers le CRM seulement si son numéro est celui d'une personne du CRM (index E.164).
+ * Un SMS de banque ou d'un proche reste sur le téléphone. Un appel n'est pas filtré : il va dans « À rattacher ».
+ */
+object FiltreSms {
+    data class Tri(val retenus: List<Map<String, Any?>>, val ecartes: List<Map<String, Any?>>)
+
+    fun trier(voulus: List<Map<String, Any?>>, index: Map<String, String>, seulsConnus: Boolean): Tri {
+        if (!seulsConnus) return Tri(voulus, emptyList())
+        val (retenus, ecartes) = voulus.partition { v ->
+            val e164 = v["_e164"] as String?
+            !e164.isNullOrEmpty() && index.containsKey(e164)
+        }
+        return Tri(retenus, ecartes)
+    }
+}
diff --git a/packages/twenty-apps/veridian/telephonie/android/contrat/src/test/kotlin/site/veridian/telephonie/contrat/FiltreSmsTest.kt b/packages/twenty-apps/veridian/telephonie/android/contrat/src/test/kotlin/site/veridian/telephonie/contrat/FiltreSmsTest.kt
new file mode 100644
index 0000000000..c63d5768bf
--- /dev/null
+++ b/packages/twenty-apps/veridian/telephonie/android/contrat/src/test/kotlin/site/veridian/telephonie/contrat/FiltreSmsTest.kt
@@ -0,0 +1,23 @@
+package site.veridian.telephonie.contrat
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class FiltreSmsTest {
+    private val index = mapOf("+33611111111" to "personne-1")
+    private fun sms(id: String, e164: String?) = mapOf<String, Any?>("idSource" to id, "_e164" to e164)
+
+    @Test fun seulsLesNumerosConnusPartent() {
+        val voulus = listOf(sms("a", "+33611111111"), sms("b", "+33622222222"), sms("c", null), sms("d", ""))
+        val tri = FiltreSms.trier(voulus, index, seulsConnus = true)
+        assertEquals(listOf("a"), tri.retenus.map { it["idSource"] })
+        assertEquals(listOf("b", "c", "d"), tri.ecartes.map { it["idSource"] })
+    }
+
+    @Test fun toutPartQuandLeReglageEstCoupe() {
+        val voulus = listOf(sms("a", "+33611111111"), sms("b", "+33622222222"))
+        val tri = FiltreSms.trier(voulus, index, seulsConnus = false)
+        assertEquals(2, tri.retenus.size)
+        assertEquals(0, tri.ecartes.size)
+    }
+}
